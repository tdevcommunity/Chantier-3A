# Copier vers .env : cp .env.example .env
# Redémarrer `npm run dev` après toute modification.
#
# Sécurité : seules les variables VITE_* sont exposées au navigateur.
# Ne jamais committer .env ni y mettre de clés secrètes backend.

# --- API (développement) ---
# Cible du proxy Vite : les requêtes /api/* sont relayées vers ce serveur.
# VITE_DEV_API_PROXY=http://127.0.0.1:8088

# --- API (production ou build) ---
# Option A (recommandée avec frontend-web/vercel.json) : ne pas définir VITE_API_URL ;
# le front appelle /api sur le même domaine Vercel, proxy vers Render.
# Option B : URL absolue (avec ou sans /api ; le code ajoute /api si absent) :
# VITE_API_URL=https://chantier-3a.onrender.com

# --- Événement vitrine ---
# Slug côté API (doit exister en base : billetterie-api seed-festival sur le backend).
# La landing est statique ; le checkout appelle GET /api/events/…
# VITE_FESTIVAL_EVENT_SLUG=tdev-festival-2026

# --- Paiement Velto (Kiiako, redirect checkout) ---
# Clé publique sandbox pk_sandbox_... (la clé secrète sk_sandbox_... reste dans backend/.env).
# VITE_VELTO_PUBLIC_KEY=pk_sandbox_...

# --- Administration (obligatoire pour activer le dashboard ; min. 12 caractères) ---
# Local : définir dans .env
# Vercel : .env.production (défaut du dépôt) ou variable VITE_ADMIN_ROUTE dans le dashboard.
# Générer un segment : openssl rand -hex 6  →  ex. /gestion-a1b2c3d4e5f6
# VITE_ADMIN_ROUTE=/gestion-a1b2c3d4e5f6

# --- Réseaux sociaux (optionnel, URLs publiques HTTPS) ---
# VITE_LINKEDIN_URL=https://www.linkedin.com/company/tdevorg
# VITE_YOUTUBE_URL=https://www.youtube.com/@tdevcommunity
# VITE_TWITTER_URL=https://twitter.com/tdev228
# VITE_FACEBOOK_URL=https://www.facebook.com/Tdev228
# VITE_INSTAGRAM_URL=https://www.instagram.com/...

# --- Connexion staff (si réutilisation des composants vitrine) ---
# VITE_STAFF_AUTH_PATH=/acces-equipe
